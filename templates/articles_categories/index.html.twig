{% extends 'base.html.twig' %}

{% block title %}Catégories d'articles{% endblock %}
{% block page_title %}Catégories d'articles{% endblock %}
{% block stylesheets %}{{ include('partials/_datatable_css.html.twig') }}{% endblock %}

{% block body %}
<div class="card">
  <div class="card-header flex-wrap">
    <h4 class="card-title">Catégories ({{ articles_categories|length }})</h4>
    <div>
      <a href="{{ path('app_articles_sous_categorie_index') }}" class="btn btn-light btn-sm">Tous les articles</a>
      <a href="{{ path('app_tarif_index') }}" class="btn btn-light btn-sm">Services &amp; tarifs</a>
      <a href="#" data-bs-toggle="modal" data-bs-target="#categorie" class="btn btn-primary btn-rounded"><i class="fas fa-plus"></i> Ajouter une catégorie</a>
    </div>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped datatable" style="min-width: 500px">
        <thead>
          <tr>
            <th>Catégorie</th>
            <th class="text-center">Articles</th>
            <th class="text-end no-sort">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for c in articles_categories %}
            <tr>
              <td><a href="{{ path('app_articles_sous_categorie_show', {url: c.url}) }}"><strong>{{ c.noms }}</strong></a></td>
              <td class="text-center"><span class="badge bg-light text-dark">{{ c.articlesSousCategories|length }}</span></td>
              <td class="text-end text-nowrap">
                <a href="{{ path('app_articles_sous_categorie_show', {url: c.url}) }}" class="btn btn-sm btn-outline-primary" title="Voir les articles"><i class="fas fa-eye"></i></a>
                <a href="{{ path('app_articles_categories_edit', {url: c.url}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier"><i class="fas fa-pencil-alt"></i></a>
                <form method="post" action="{{ path('app_articles_categories_delete', {url: c.url}) }}" class="d-inline" onsubmit="return confirm('Supprimer la catégorie « {{ c.noms|e('js') }} » et ses articles ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c.id) }}">
                  <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if not articles_categories %}<p class="text-muted text-center mb-0">Aucune catégorie : ajoutez-en une (Vêtements, Linge de maison, Chaussures…).</p>{% endif %}
  </div>
</div>

<div class="modal fade" id="categorie" tabindex="-1" aria-labelledby="categorieLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categorieLabel">Nouvelle catégorie</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      {{ form_start(form) }}
      <div class="modal-body">
        {{ form_errors(form) }}
        <label class="col-form-label">Nom de la catégorie</label>
        {{ form_widget(form.noms) }}
        {{ form_errors(form.noms) }}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ include('partials/_datatable_js.html.twig') }}
{% if ouvrir_modal|default(false) %}<script>jQuery(function () { new bootstrap.Modal(document.getElementById('categorie')).show(); });</script>{% endif %}
{% endblock %}
