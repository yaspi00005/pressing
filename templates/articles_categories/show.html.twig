{% extends 'base.html.twig' %}

{% block title %}Catégorie{% endblock %}
{% block page_title %}Catégorie{% endblock %}
{% block body %}
<div class="card">
  <div class="card-header"><h4 class="card-title">Catégorie</h4></div>
  <div class="card-body">
    <table class="table">
      <tbody>
        <tr><th>Id</th><td>{{ articles_category.id }}</td></tr>
        <tr><th>Nom</th><td>{{ articles_category.noms }}</td></tr>
      </tbody>
    </table>
    <a href="{{ path('app_articles_categories_index') }}" class="btn btn-light">Retour à la liste</a>
    <a href="{{ path('app_articles_categories_edit', {'id': articles_category.id}) }}" class="btn btn-primary">Modifier</a>
    {{ include('articles_categories/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
