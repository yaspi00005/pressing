{% extends 'base.html.twig' %}

{% block title %}Modifier la catégorie{% endblock %}

{% block body %}
<div class="row"><div class="col-lg-6 offset-lg-3">
  <div class="card">
    <div class="card-header"><h4 class="card-title">{{ articles_category.noms }}</h4></div>
    <div class="card-body">
      {{ form_start(form) }}
        {{ form_row(form.noms) }}
        <button class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('app_articles_categories_index') }}" class="btn btn-light">Retour à la liste</a>
      {{ form_end(form) }}
    </div>
  </div>
</div></div>
{% endblock %}
