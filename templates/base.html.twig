<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Pressing{% endblock %}</title>
    <link rel="shortcut icon" type="image/png" href="{{domaine}}/workload/images/favicon.png">
    <link rel="stylesheet" href="{{domaine}}/workload/vendor/jquery-nice-select/css/nice-select.css">
    {% block stylesheets %}{% endblock %}
    <link rel="stylesheet" href="{{domaine}}/workload/css/style.css">
</head>
<body>
    <div id="preloader">
        <div class="lds-ripple">
            <div></div>
            <div></div>
        </div>
    </div>

    <div id="main-wrapper">
        {# Nav header #}
        <div class="nav-header">
            <a href="{{ path('app_clients_index') }}" class="brand-logo">
                <img class="logo-abbr" src="{{domaine}}/workload/images/logo.png" width="60" height="60" alt="Pressing">
                <img class="brand-title" src="{{domaine}}/workload/images/logo-text.png" alt="Pressing">
            </a>
            <div class="nav-control">
                <div class="hamburger">
                    <span class="line"></span><span class="line"></span><span class="line"></span>
                </div>
            </div>
        </div>

        {# Header #}
        <div class="header border-bottom">
            <div class="header-content">
                <nav class="navbar navbar-expand">
                    <div class="collapse navbar-collapse justify-content-between">
                        <div class="header-left">
                            <div class="dashboard_bar">{% block page_title %}Pressing{% endblock %}</div>
                        </div>
                        <ul class="navbar-nav header-right">
                            <li class="nav-item dropdown header-profile">
                                <a class="nav-link" href="javascript:void(0);" role="button" data-bs-toggle="dropdown">
                                    <img src="{{domaine}}/workload/images/user.jpg" width="20" alt="">
                                    <div class="header-info ms-3">
                                        <span class="fs-18 font-w500 mb-2">{{ app.user ? app.user.userIdentifier : 'Invité' }}</span>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    {% if app.user %}
                                        <a href="{{ path('app_logout') }}" class="dropdown-item ai-icon">
                                            <i class="fas fa-sign-out-alt text-danger"></i>
                                            <span class="ms-2">Déconnexion</span>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="dropdown-item ai-icon">
                                            <i class="fas fa-sign-in-alt text-primary"></i>
                                            <span class="ms-2">Connexion</span>
                                        </a>
                                    {% endif %}
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>

        {# Sidebar #}
        <div class="dlabnav">
            <div class="dlabnav-scroll">
                <ul class="metismenu" id="menu">
                    <li>
                        <a class="has-arrow" href="javascript:void(0);" aria-expanded="false">
                            <i class="fas fa-user"></i>
                            <span class="nav-text">Clients</span>
                        </a>
                        <ul aria-expanded="false">
                            <li><a href="{{ path('app_clients_new') }}">Nouveau client</a></li>
                            <li><a href="{{ path('app_clients_index') }}">Liste des clients</a></li>
                        </ul>
                    </li>
                    <li>
                        <a href="{{ path('app_articles_categories_index') }}" aria-expanded="false">
                            <i class="fas fa-shirt"></i>
                            <span class="nav-text">Gestion articles</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        {# Content #}
        <div class="content-body">
            <div class="container-fluid">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </div>
        </div>

        <div class="footer">
            <div class="copyright">
                <p>Pressing &copy; {{ 'now'|date('Y') }}</p>
            </div>
        </div>
    </div>

    <script src="{{domaine}}/workload/vendor/global/global.min.js"></script>
    <script src="{{domaine}}/workload/vendor/jquery-nice-select/js/jquery.nice-select.min.js"></script>
    {% block javascripts %}{% endblock %}
    <script src="{{domaine}}/workload/js/custom.min.js"></script>
    <script src="{{domaine}}/workload/js/dlabnav-init.js"></script>
</body>
</html>
