<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Pressing{% endblock %}</title>
    <link rel="shortcut icon" type="image/png" href="{{ asset('workload/images/favicon.png') }}">
    <link rel="stylesheet" href="{{ asset('workload/vendor/jquery-nice-select/css/nice-select.css') }}">
    {% block stylesheets %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('workload/css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('workload/css/pressing.css') }}">
</head>
<body>
    <div id="preloader">
        <div class="lds-ripple">
            <div></div>
            <div></div>
        </div>
    </div>

    <div id="main-wrapper">
        {# Nav header #}
        <div class="nav-header">
            <a href="{{ path('app_dashboard') }}" class="brand-logo">
                <span class="logo-abbr d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white" style="width:50px;height:50px;font-size:22px"><i class="fas fa-tshirt"></i></span>
                <span class="brand-title fs-3 fw-bold text-primary ms-2">Pressing</span>
            </a>
            <div class="nav-control">
                <div class="hamburger">
                    <span class="line"></span><span class="line"></span><span class="line"></span>
                </div>
            </div>
        </div>

        {# Header #}
        <div class="header border-bottom">
            <div class="header-content">
                <nav class="navbar navbar-expand">
                    <div class="collapse navbar-collapse justify-content-between">
                        <div class="header-left">
                            <div class="dashboard_bar">{% block page_title %}Pressing{% endblock %}</div>
                        </div>
                        <ul class="navbar-nav header-right">
                            <li class="nav-item dropdown header-profile">
                                <a class="nav-link" href="javascript:void(0);" role="button" data-bs-toggle="dropdown">
                                    <img src="{{ asset('workload/images/user.jpg') }}" width="20" alt="">
                                    <div class="header-info ms-3">
                                        <span class="fs-18 font-w500 mb-2">{{ app.user ? app.user.userIdentifier : 'Invité' }}</span>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    {% if app.user %}
                                        <a href="{{ path('app_logout') }}" class="dropdown-item ai-icon">
                                            <i class="fas fa-sign-out-alt text-danger"></i>
                                            <span class="ms-2">Déconnexion</span>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="dropdown-item ai-icon">
                                            <i class="fas fa-sign-in-alt text-primary"></i>
                                            <span class="ms-2">Connexion</span>
                                        </a>
                                    {% endif %}
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>

        {# Sidebar #}
        <div class="dlabnav">
            <div class="dlabnav-scroll">
                <ul class="metismenu" id="menu">
                    <li><a href="{{ path('app_dashboard') }}" aria-expanded="false"><i class="fas fa-home"></i><span class="nav-text">Tableau de bord</span></a></li>
                    <li>
                        <a class="has-arrow" href="javascript:void(0);" aria-expanded="false"><i class="fas fa-receipt"></i><span class="nav-text">Commandes</span></a>
                        <ul aria-expanded="false">
                            <li><a href="{{ path('app_commande_new') }}">Nouvelle commande</a></li>
                            <li><a href="{{ path('app_commande_index') }}">Toutes les commandes</a></li>
                            <li><a href="{{ path('app_commande_index', {filtre: 'retard'}) }}">En retard</a></li>
                            <li><a href="{{ path('app_commande_index', {filtre: 'impayes'}) }}">Impayées</a></li>
                        </ul>
                    </li>
                    <li>
                        <a class="has-arrow" href="javascript:void(0);" aria-expanded="false"><i class="fas fa-user"></i><span class="nav-text">Clients</span></a>
                        <ul aria-expanded="false">
                            <li><a href="{{ path('app_clients_new') }}">Nouveau client</a></li>
                            <li><a href="{{ path('app_clients_index') }}">Liste des clients</a></li>
                        </ul>
                    </li>
                    <li>
                        <a class="has-arrow" href="javascript:void(0);" aria-expanded="false"><i class="fas fa-tshirt"></i><span class="nav-text">Catalogue</span></a>
                        <ul aria-expanded="false">
                            <li><a href="{{ path('app_articles_categories_index') }}">Articles</a></li>
                            <li><a href="{{ path('app_tarif_index') }}">Services &amp; tarifs</a></li>
                        </ul>
                    </li>
                    <li>
                        <a class="has-arrow" href="javascript:void(0);" aria-expanded="false"><i class="fas fa-cash-register"></i><span class="nav-text">Caisse</span></a>
                        <ul aria-expanded="false">
                            <li><a href="{{ path('app_caisse') }}">Rapport du jour</a></li>
                            <li><a href="{{ path('app_depense_index') }}">Dépenses</a></li>
                        </ul>
                    </li>
                    <li><a href="{{ path('app_stock_index') }}" aria-expanded="false"><i class="fas fa-boxes"></i><span class="nav-text">Stock produits</span></a></li>
                    <li><a href="{{ path('app_reclamation_index') }}" aria-expanded="false"><i class="fas fa-comment-dots"></i><span class="nav-text">Réclamations</span></a></li>
                </ul>
            </div>
        </div>

        {# Content #}
        <div class="content-body">
            <div class="container-fluid">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </div>
        </div>

        <div class="footer">
            <div class="copyright">
                <p>Pressing &copy; {{ 'now'|date('Y') }}</p>
            </div>
        </div>
    </div>

    <script src="{{ asset('workload/vendor/global/global.min.js') }}"></script>
    <script src="{{ asset('workload/vendor/jquery-nice-select/js/jquery.nice-select.min.js') }}"></script>
    {% block javascripts %}{% endblock %}
    <script src="{{ asset('workload/js/custom.min.js') }}"></script>
    <script src="{{ asset('workload/js/dlabnav-init.js') }}"></script>
</body>
</html>
