<form method="post" action="{{ path('app_clients_delete', {'id': client.id}) }}" data-confirm="Le client sera supprimé définitivement (impossible s'il a des commandes)." data-confirm-titre="Supprimer ce client ?" data-confirm-type="danger" data-confirm-bouton="Oui, supprimer">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
    <button class="btn btn-outline-danger w-100"><i class="fas fa-trash"></i> Supprimer le client</button>
</form>
