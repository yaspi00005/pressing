                                            <th>Telephones</th>
                                            <th>Genres</th>
                                            <th>Adresse</th>
                                            <th>actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for client in clients %}
                                        <tr>
                                            <td>{{ client.prenom }} {{ client.nom }}</td>
                                            <td>{{ client.telephones }}</td>
                                            <td>{{ client.genres }}</td>
                                            <td>{{ client.adresses }}</td>
                                            <td class='text-center'>
                                                <a href="{{ path('app_clients_edit', {'id': client.id}) }}"><i class='fas fa-edit' ></i></a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="7">no records found</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                                <a href="{{ path('app_clients_new') }}">Créer un nouveau</a>
							</div>
						</div>
					</div>
