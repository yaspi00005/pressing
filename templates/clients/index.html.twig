{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}
{% block page_title %}Clients{% endblock %}
{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('workload/vendor/datatables/css/jquery.dataTables.min.css') }}">
{% endblock %}
{% block body %}
<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header flex-wrap">
        <h4 class="card-title">Liste des clients</h4>
        <a href="{{ path('app_clients_new') }}" class="btn btn-primary btn-rounded"><i class="fas fa-plus"></i> Nouveau client</a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table id="clients-table" class="display table" style="min-width: 600px">
            <thead>
              <tr>
                <th>Clients</th>
                <th>Téléphones</th>
                <th>Genres</th>
                <th>Adresse</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for client in clients %}
                <tr>
                  <td>{{ client.prenom }} {{ client.nom }}</td>
                  <td>{{ client.telephones }}</td>
                  <td>{{ client.genres }}</td>
                  <td>{{ client.adresses }}</td>
                  <td class="text-center">
                    <a href="{{ path('app_clients_show', {'id': client.id}) }}" title="Fiche et historique"><i class="fas fa-eye"></i></a>
                    <a href="{{ path('app_commande_new', {client: client.id}) }}" class="ms-2" title="Nouvelle commande"><i class="fas fa-plus-circle"></i></a>
                    <a href="{{ path('app_clients_edit', {'id': client.id}) }}" class="ms-2" title="Modifier"><i class="fas fa-edit"></i></a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% block javascripts %}
  <script src="{{ asset('workload/vendor/datatables/js/jquery.dataTables.min.js') }}"></script>
  <script>
    jQuery(function ($) { $('#clients-table').DataTable({ language: { search: 'Rechercher :' } }); });
  </script>
{% endblock %}
