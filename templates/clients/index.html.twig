					<div class="row">
						<div class="col-sm-5 col-4">
							<h4 class="page-title"></h4>
						</div>
						<div class="col-sm-7 col-8 text-right m-b-30">
							<a href="#" data-toggle="modal" data-target="#categorie" data-whatever="@mdo" class="btn btn-primary btn-rounded"><i class="fas fa-plus"></i> Ajouter une catégorie</a>
						</div>
					</div>
				
					<div class="row">
