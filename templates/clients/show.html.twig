{% extends 'base.html.twig' %}

{% block title %}Client{% endblock %}
{% block page_title %}Client{% endblock %}
{% block body %}
<div class="card">
  <div class="card-header"><h4 class="card-title">Client</h4></div>
  <div class="card-body">
    <table class="table">
      <tbody>
        <tr><th>Id</th><td>{{ client.id }}</td></tr>
        <tr><th>Prénom</th><td>{{ client.prenom }}</td></tr>
        <tr><th>Nom</th><td>{{ client.nom }}</td></tr>
        <tr><th>Téléphones</th><td>{{ client.telephones }}</td></tr>
        <tr><th>Genres</th><td>{{ client.genres }}</td></tr>
        <tr><th>Adresse</th><td>{{ client.adresse }}</td></tr>
      </tbody>
    </table>
    <a href="{{ path('app_clients_index') }}" class="btn btn-light">Retour à la liste</a>
    <a href="{{ path('app_clients_edit', {'id': client.id}) }}" class="btn btn-primary">Modifier</a>
    {{ include('clients/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
