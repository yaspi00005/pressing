{% extends 'base.html.twig' %}

{% block title %}Nouveau clients{% endblock %}
{% block stylesheets %}
 <link rel="stylesheet" type="text/css" href="{{domaine}}/assets/css/select2.min.css">
{% endblock %}
{% block body %}
    <h1>Créer de nouveaux clients</h1>
  <div class="content">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="buy-form">
                    <h4 class="page-title">Add Employee</h4>
                {{ form_start(form) }}
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Prénom <span class="text-danger">*</span></label>
                                 {{ form_errors(form.prenom) }}
                                 {{ form_widget(form.prenom) }}
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                 <label>Nom <span class="text-danger">*</span></label>
                                 {{ form_errors(form.nom) }}
                                 {{ form_widget(form.nom) }}
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Téléphone <span class="text-danger">*</span></label>
                                 {{ form_errors(form.telephones) }}
                                 {{ form_widget(form.telephones) }}
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Courriel <span class="text-danger">*</span></label>
                                {{ form_errors(form.email) }}
                                {{ form_widget(form.email) }}
                            </div>
                        </div>
                       
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Adresse </label>
                                 {{ form_errors(form.adresses) }}
                                 {{ form_widget(form.adresses) }}
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Genres </label>
                                 {{ form_errors(form.genres) }}
                                 {{ form_widget(form.genres) }}
                            </div>
                        </div>
                       
                    </div>
                    <div class="m-t-20 text-center">
                        <button class="btn btn-primary submit-btn">Ajouter</button>
                    </div>
                {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
