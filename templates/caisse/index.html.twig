{% extends 'base.html.twig' %}

{% block title %}Paiements{% endblock %}

{% block body %}
{# Totaux en haut #}
<div class="row g-2">
    {% set cartes = [
        {l: 'Encaissé', v: resume.total|money, i: 'fa-coins', c: 'success', d: resume.nb ~ ' paiement' ~ (resume.nb > 1 ? 's' : '')},
        {l: 'Dépenses', v: totalDepenses|money, i: 'fa-wallet', c: 'danger', d: null},
        {l: 'Solde de la période', v: solde|money, i: 'fa-balance-scale', c: (solde >= 0 ? 'primary' : 'danger'), d: null},
    ] %}
    {% for k in cartes %}
        <div class="col-xl-4 col-md-4 col-12">
            <div class="card carte-chiffre"><div class="card-body d-flex align-items-center gap-3">
                <span class="icone bg-{{ k.c }}-subtle text-{{ k.c }}"><i class="fas {{ k.i }}"></i></span>
                <div><div class="valeur">{{ k.v }}</div><div class="legende">{{ k.l }}{% if k.d %} · {{ k.d }}{% endif %}</div></div>
            </div></div>
        </div>
    {% endfor %}
</div>

<div class="row">
    <div class="col-xl-9">
        <div class="card">
            <div class="card-header flex-wrap gap-2">
                <h4 class="card-title">{{ pagination.total }} opération{{ pagination.total > 1 ? 's' }}</h4>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('app_caisse_export', app.request.query.all) }}" class="btn btn-outline-primary btn-sm"><i class="fas fa-file-excel"></i> Export Excel</a>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-print><i class="fas fa-print"></i> Imprimer</button>
                </div>
            </div>
            <div class="card-body">
                <form method="get" class="row g-2 filtres-liste">
                    <div class="col-md-2 col-6"><input type="date" name="du" value="{{ filtres.du }}" class="form-control js-auto-submit" aria-label="Du"></div>
                    <div class="col-md-2 col-6"><input type="date" name="au" value="{{ filtres.au }}" class="form-control js-auto-submit" aria-label="Au"></div>
                    <div class="col-md-2">
                        <select name="mode" class="form-select js-auto-submit"><option value="">Tous modes</option>{% for k, l in modes %}<option value="{{ k }}" {{ filtres.mode == k ? 'selected' }}>{{ l }}</option>{% endfor %}</select>
                    </div>
                    <div class="col-md-3">
                        <select name="user" class="form-select js-auto-submit"><option value="">Tous caissiers</option>{% for u in caissiers %}<option value="{{ u.id }}" {{ filtres.user == u.id ? 'selected' }}>{{ u.nomComplet }}</option>{% endfor %}</select>
                    </div>
                    <div class="col-md-3 d-flex gap-1">
                        <input type="search" name="q" value="{{ filtres.q }}" class="form-control" placeholder="N°, client, réf.">
                        <button class="btn btn-primary btn-sm" title="Filtrer"><i class="fas fa-filter"></i></button>
                        <a href="{{ path('app_caisse') }}" class="btn btn-light btn-sm" title="Aujourd'hui"><i class="fas fa-times"></i></a>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Date</th><th>Commande</th><th>Client</th><th>Mode</th><th class="d-none d-md-table-cell">Caissier</th><th class="num">Montant</th></tr></thead>
                        <tbody>
                            {% for p in pagination.items %}
                                <tr>
                                    <td>{{ p.datePaiement|date('d/m/Y H:i') }}</td>
                                    <td><a href="{{ path('app_commande_show', {id: p.commande.id}) }}" class="text-primary fw-bold">{{ p.commande.numero }}</a></td>
                                    <td>{{ p.commande.client.nomComplet }}</td>
                                    <td>{{ p.modeLabel }}{% if p.reference %}<br><small>{{ p.reference }}</small>{% endif %}</td>
                                    <td class="d-none d-md-table-cell">{{ p.createdBy ? p.createdBy.nomComplet : '—' }}</td>
                                    <td class="num">{{ p.montant|money }}</td>
                                </tr>
                            {% else %}
                                {{ include('partials/_empty_state.html.twig', {colonnes: 6, message: 'Aucun paiement sur cette période.', icone: 'fa-coins'}, with_context = false) }}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {{ include('partials/_pagination.html.twig') }}
            </div>
        </div>
    </div>
    <div class="col-xl-3">
        <div class="card">
            <div class="card-header"><h4 class="card-title">Par mode de paiement</h4></div>
            <div class="card-body pt-0">
                <table class="table mb-0">
                    {% for mode, total in resume.parMode %}<tr><td>{{ modes[mode]|default(mode) }}</td><td class="num">{{ total|money }}</td></tr>{% else %}<tr><td class="text-muted">—</td></tr>{% endfor %}
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h4 class="card-title">Par caissier</h4></div>
            <div class="card-body pt-0">
                <table class="table mb-0">
                    {% for nom, total in resume.parCaissier %}<tr><td>{{ nom }}</td><td class="num">{{ total|money }}</td></tr>{% else %}<tr><td class="text-muted">—</td></tr>{% endfor %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
