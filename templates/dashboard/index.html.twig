{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block breadcrumb %}{% endblock %}

{% macro carte(libelle, valeur, icone, couleur, url, detail) %}
    <div class="col-xl-3 col-sm-6 col-6">
        <a href="{{ url }}" class="card d-block text-decoration-none carte-chiffre">
            <div class="card-body d-flex align-items-center gap-3">
                <span class="icone bg-{{ couleur }}-subtle text-{{ couleur }}"><i class="fas {{ icone }}"></i></span>
                <div>
                    <div class="valeur">{{ valeur }}</div>
                    <div class="legende">{{ libelle }}{% if detail %} · {{ detail }}{% endif %}</div>
                </div>
            </div>
        </a>
    </div>
{% endmacro %}
{% import _self as m %}

{% block body %}
{# Bandeau d'accueil #}
<div class="bandeau-accueil">
    <div>
        <h3>Bonjour {{ app.user.prenom }} 👋</h3>
        <p class="small">{{ nb_en_cours }} commande(s) en cours · {{ nb_pretes }} prête(s) à retirer · {{ nb_retards }} en retard</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_guichet') }}" class="btn btn-light btn-sm"><i class="fas fa-search"></i> Guichet</a>
        {% if is_granted('ROLE_RECEPTION') %}<a href="{{ path('app_commande_new') }}" class="btn btn-light btn-sm"><i class="fas fa-plus"></i> Nouvelle commande</a>{% endif %}
    </div>
</div>

{# Première rangée : quatre compteurs d'activité #}
<div class="row g-2">
    {{ m.carte('Dépôts du jour', depots_jour, 'fa-inbox', 'primary', path('app_commande_index'), null) }}
    {{ m.carte('En cours', nb_en_cours, 'fa-spinner', 'warning', path('app_commande_index', {filtre: 'encours'}), null) }}
    {{ m.carte('Prêtes à retirer', nb_pretes, 'fa-box-open', 'info', path('app_commande_index', {statut: 'pret'}), null) }}
    {{ m.carte('En retard', nb_retards, 'fa-clock', 'danger', path('app_commande_index', {filtre: 'retard'}), null) }}
</div>

{# Deuxième rangée : argent (réception / administrateur) #}
{% if is_granted('ROLE_RECEPTION') %}
<div class="row g-2">
    {{ m.carte("Encaissé aujourd'hui", encaisse_jour|money, 'fa-coins', 'success', path('app_caisse'), null) }}
    {{ m.carte('Encaissé ce mois', encaisse_mois|money, 'fa-chart-line', 'success', path('app_caisse', {du: 'now'|date('Y-m-01'), au: 'now'|date('Y-m-d')}), null) }}
    {{ m.carte('Reste à encaisser', impayes.montant|money, 'fa-hand-holding-usd', 'warning', path('app_commande_index', {filtre: 'impayes'}), impayes.nb ~ ' cmd') }}
    {% if is_granted('ROLE_ADMIN') %}
        {{ m.carte('Résultat du mois', resultat_mois|money, 'fa-balance-scale', resultat_mois >= 0 ? 'primary' : 'danger', path('app_depense_index'), 'dépenses ' ~ depenses_mois|money) }}
    {% else %}
        {{ m.carte('Clients', nb_clients, 'fa-users', 'primary', path('app_clients_index'), null) }}
    {% endif %}
</div>
{% endif %}

<div class="row">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header flex-wrap gap-2">
                <h4 class="card-title"><i class="fas fa-chart-bar text-primary me-2"></i>Commandes par mois</h4>
                <span class="text-muted small">12 derniers mois</span>
            </div>
            <div class="card-body">
                <div class="graphique"><canvas data-chart="{{ {type: 'bar', data: {labels: mois|map(x => x.label), datasets: [{label: 'Commandes', data: mois|map(x => x.nb)}]}}|json_encode|e('html_attr') }}"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-chart-pie text-primary me-2"></i>Répartition par statut</h4></div>
            <div class="card-body">
                {% set libelles = [] %}{% set valeurs = [] %}
                {% for cle, label in constant('App\\Entity\\Commande::STATUTS') %}{% set libelles = libelles|merge([label]) %}{% set valeurs = valeurs|merge([par_statut[cle]|default(0)]) %}{% endfor %}
                <div class="graphique"><canvas data-chart="{{ {type: 'doughnut', data: {labels: libelles, datasets: [{data: valeurs, backgroundColor: ['#9ca3af', '#f5b83d', '#38a9f5', '#00A15D', '#ef4444']}]}, options: {cutoutPercentage: 62}}|json_encode|e('html_attr') }}"></canvas></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header flex-wrap gap-2">
                <h4 class="card-title"><i class="fas fa-list text-primary me-2"></i>À traiter en priorité</h4>
                <a href="{{ path('app_commande_index', {filtre: 'encours'}) }}" class="btn btn-light btn-sm">Voir tout</a>
            </div>
            <div class="card-body pt-0">
                <div class="table-responsive">{{ include('commande/_table.html.twig', {commandes: a_traiter, compact: true}) }}</div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        {% if is_granted('ROLE_RECEPTION') %}
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-medal text-primary me-2"></i>Meilleurs clients du mois</h4></div>
            <div class="card-body pt-0">
                <table class="table table-hover mb-0">
                    {% for t in top_clients %}
                        <tr>
                            <td><a href="{{ path('app_clients_show', {id: t.client.id}) }}" class="fw-bold">{{ t.client.nomComplet }}</a><br><small>{{ t.nb }} commande(s)</small></td>
                            <td class="num">{{ t.total|money }}</td>
                        </tr>
                    {% else %}
                        {{ include('partials/_empty_state.html.twig', {colonnes: 2, message: 'Aucune commande ce mois-ci.', icone: 'fa-medal'}, with_context = false) }}
                    {% endfor %}
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-coins text-primary me-2"></i>Encaissements — 7 jours</h4></div>
            <div class="card-body">
                <div class="graphique" style="height: 150px"><canvas data-chart="{{ {type: 'bar', data: {labels: semaine|map(x => x.label), datasets: [{label: 'FCFA', data: semaine|map(x => x.total)}]}}|json_encode|e('html_attr') }}"></canvas></div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}<script src="{{ asset('theme/vendor/chart.js/Chart.bundle.min.js') }}"></script>{% endblock %}
