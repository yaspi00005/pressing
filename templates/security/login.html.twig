
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <link rel="shortcut icon" type="image/x-icon" href="{{domaine}}/assets/img/favicon.ico">
    <title>Cryptocurrency - Bootstrap 4 Admin Template</title>
    <link rel="stylesheet" type="text/css" href="{{domaine}}/assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="{{domaine}}/assets/plugins/fontawesome/css/fontawesome.min.css" >
    <link rel="stylesheet" type="text/css" href="{{domaine}}/assets/plugins/fontawesome/css/all.min.css" >
    <link rel="stylesheet" type="text/css" href="{{domaine}}/assets/css/style.css">
    <!--[if lt IE 9]>
		<script src="{{domaine}}/assets/js/html5shiv.min.js"></script>
		<script src="{{domaine}}/assets/js/respond.min.js"></script>
	<![endif]-->
</head>

<body>
	<div class="main-wrapper account-wrapper bg-wrapper">
        <div class="account-page">
			<div class="account-center">
				<div class="account-box">
                    <form method="post" class="form-signin">
                       {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {% if app.user %}
                            <div class="mb-3">
                                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                            </div>
                        {% endif %}
						<div class="account-logo">
                            <a href="index.html"><img src="{{domaine}}/assets/img/logo.png" alt="Logo"></a>
                        </div>
                        <div class="form-group">
                            <label>Nom d'utilisateur</label>
                            <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control" autocomplete="username" required autofocus>
                        </div>
                        <div class="form-group">
                            <label>Mot de passe</label>
                            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                        </div>
                         <input type="hidden" name="_csrf_token"
           value="{{ csrf_token('authenticate') }}"
    >
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary account-btn">Connexion</button>
                        </div>
                    </form>
                </div>
			</div>
        </div>
    </div>
    <div class="sidebar-overlay" data-reff=""></div>
    <script src="{{domaine}}/assets/js/jquery-3.5.1.min.js"></script>
	<script src="{{domaine}}/assets/js/popper.min.js"></script>
    <script src="{{domaine}}/assets/js/bootstrap.min.js"></script>
    <script src="{{domaine}}/assets/js/jquery.slimscroll.js"></script>
    <script src="{{domaine}}/assets/js/app.js"></script>
</body>

</html>