<!DOCTYPE html>
<html lang="fr" class="h-100">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion - Pressing</title>
    <link rel="shortcut icon" type="image/png" href="{{domaine}}/workload/images/favicon.png">
    <link rel="stylesheet" href="{{domaine}}/workload/css/style.css">
</head>
<body class="vh-100">
    <div class="authincation h-100">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-md-6">
                    <div class="authincation-content">
                        <div class="row no-gutters">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="text-center mb-3">
                                        <img src="{{domaine}}/workload/images/logo-full.png" alt="Pressing">
                                    </div>
                                    <h4 class="text-center mb-4">Connectez-vous à votre compte</h4>
                                    <form method="post">
                                        {% if error %}
                                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                        {% endif %}
                                        {% if app.user %}
                                            <div class="mb-3">
                                                Connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
                                            </div>
                                        {% endif %}
                                        <div class="mb-3">
                                            <label class="mb-1" for="inputUsername"><strong>Nom d'utilisateur</strong></label>
                                            <input type="text" value="{{ last_username }}" name="username" id="inputUsername" class="form-control" autocomplete="username" required autofocus>
                                        </div>
                                        <div class="mb-3">
                                            <label class="mb-1" for="inputPassword"><strong>Mot de passe</strong></label>
                                            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                                        </div>
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                        <div class="text-center">
                                            <button type="submit" class="btn btn-primary btn-block">Connexion</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="{{domaine}}/workload/vendor/global/global.min.js"></script>
    <script src="{{domaine}}/workload/js/custom.min.js"></script>
    <script src="{{domaine}}/workload/js/dlabnav-init.js"></script>
</body>
</html>
