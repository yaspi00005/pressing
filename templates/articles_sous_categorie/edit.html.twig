{% extends 'base.html.twig' %}

{% block title %}Modifier l'article{% endblock %}

{% block body %}
<div class="row"><div class="col-lg-6 offset-lg-3">
  <div class="card">
    <div class="card-header"><h4 class="card-title">{{ articles_sous_categorie.noms }}</h4></div>
    <div class="card-body">
      {{ form_start(form) }}
        {% for f in form %}{% if f.vars.name != '_token' %}<div class="mb-3">{{ form_label(f) }}{{ form_widget(f) }}{{ form_errors(f) }}</div>{% endif %}{% endfor %}
        <button class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('app_articles_sous_categorie_show', {url: articles_sous_categorie.categorie.url}) }}" class="btn btn-light">Retour à la liste</a>
      {{ form_end(form) }}
    </div>
  </div>
</div></div>
{% endblock %}
