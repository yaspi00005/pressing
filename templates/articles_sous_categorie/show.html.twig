{% extends 'base.html.twig' %}

{% block title %}Sous-catégorie{% endblock %}
{% block page_title %}Sous-catégorie{% endblock %}
{% block body %}
<div class="card">
  <div class="card-header"><h4 class="card-title">Sous-catégorie</h4></div>
  <div class="card-body">
    <table class="table">
      <tbody>
        <tr><th>Id</th><td>{{ articles_sous_categorie.id }}</td></tr>
        <tr><th>Nom</th><td>{{ articles_sous_categorie.noms }}</td></tr>
        <tr><th>Code</th><td>{{ articles_sous_categorie.codeArticles }}</td></tr>
        <tr><th>Prix</th><td>{{ articles_sous_categorie.prix }}</td></tr>
      </tbody>
    </table>
    <a href="{{ path('app_articles_sous_categorie_index') }}" class="btn btn-light">Retour à la liste</a>
    <a href="{{ path('app_articles_sous_categorie_edit', {'id': articles_sous_categorie.id}) }}" class="btn btn-primary">Modifier</a>
    {{ include('articles_sous_categorie/_delete_form.html.twig') }}
  </div>
</div>
{% endblock %}
