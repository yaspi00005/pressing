{% extends 'base.html.twig' %}

{% set titre = categorie ? categorie.noms : 'Tous les articles' %}
{% block title %}{{ titre }}{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}
{% block stylesheets %}{{ include('partials/_datatable_css.html.twig') }}{% endblock %}

{% block body %}
<div class="card">
  <div class="card-header flex-wrap">
    <h4 class="card-title">{{ categorie ? 'Articles de la catégorie « ' ~ categorie.noms ~ ' »' : 'Tous les articles' }} ({{ articles_sous_categories|length }})</h4>
    <div>
      <a href="{{ path('app_articles_categories_index') }}" class="btn btn-light btn-sm"><i class="fas fa-arrow-left"></i> Catégories</a>
      <a href="{{ path('app_tarif_index') }}" class="btn btn-light btn-sm">Services &amp; tarifs</a>
      <a href="#" data-bs-toggle="modal" data-bs-target="#article" class="btn btn-primary btn-rounded"><i class="fas fa-plus"></i> Ajouter un article</a>
    </div>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped datatable" style="min-width: 600px">
        <thead>
          <tr>
            <th>Article</th>
            {% if not categorie %}<th>Catégorie</th>{% endif %}
            <th>Code</th>
            <th class="text-end">Prix de base</th>
            <th class="text-end no-sort">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for a in articles_sous_categories %}
            <tr>
              <td><strong>{{ a.noms }}</strong></td>
              {% if not categorie %}<td><a href="{{ path('app_articles_sous_categorie_show', {url: a.categorie.url}) }}">{{ a.categorie.noms }}</a></td>{% endif %}
              <td>{{ a.codeArticles ?: '—' }}</td>
              <td class="text-end" data-order="{{ a.prix }}">{{ a.prix|money }}</td>
              <td class="text-end text-nowrap">
                <a href="{{ path('app_articles_sous_categorie_edit', {url: a.url}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier"><i class="fas fa-pencil-alt"></i></a>
                <form method="post" action="{{ path('app_articles_sous_categorie_delete', {url: a.url}) }}" class="d-inline" onsubmit="return confirm('Supprimer l\'article « {{ a.noms|e('js') }} » ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ a.id) }}">
                  <button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if not articles_sous_categories %}<p class="text-muted text-center mb-0">Aucun article. Le prix de base sert quand aucun tarif par service n'est défini.</p>{% endif %}
  </div>
</div>

<div class="modal fade" id="article" tabindex="-1" aria-labelledby="articleLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="articleLabel">Nouvel article</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      {{ form_start(form) }}
      <div class="modal-body">
        {{ form_errors(form) }}
        {% for f in form %}
          {% if f.vars.name != '_token' %}<div class="mb-3">{{ form_label(f) }}{{ form_widget(f) }}{{ form_errors(f) }}</div>{% endif %}
        {% endfor %}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts %}
{{ include('partials/_datatable_js.html.twig') }}
{% if ouvrir_modal|default(false) %}<script>jQuery(function () { new bootstrap.Modal(document.getElementById('article')).show(); });</script>{% endif %}
{% endblock %}
