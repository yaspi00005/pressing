<div class="modal fade" id="categorie" tabindex="-1" role="dialog" aria-labelledby="categorieLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categorieLabel">Nouvelle sous-catégorie</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
    {{ form_start(form) }}
      <div class="modal-body">
          <div class="form-group">
            <label for="recipient-name" class="col-form-label">Nom article:</label>
           {{ form_widget(form.noms) }}
          </div>
          <div class="form-group">
            <label for="recipient-name" class="col-form-label">Code article:</label>
           {{ form_widget(form.codeArticles) }}
          </div>
          <div class="form-group">
            <label for="recipient-name" class="col-form-label">Prix:</label>
           {{ form_widget(form.prix) }}
          </div>
       
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
     {{ form_end(form) }}
    </div>
  </div>
</div>
