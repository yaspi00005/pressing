{% extends 'base.html.twig' %}

{% block title %}Sous-catégories{% endblock %}
{% block page_title %}Sous-catégories{% endblock %}
{% block body %}
<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header flex-wrap">
        <h4 class="card-title">Sous-catégories</h4>
        <a href="#" data-bs-toggle="modal" data-bs-target="#categorie" class="btn btn-primary btn-rounded"><i class="fas fa-plus"></i> Ajouter une sous-catégorie</a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-striped mb-0">
            <thead>
              <tr>
                <th>Nom</th>
                <th>Code</th>
                <th>Prix</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              {% for articles_sous_categorie in articles_sous_categories %}
                <tr>
                  <td>{{ articles_sous_categorie.noms }}</td>
                  <td>{{ articles_sous_categorie.codeArticles }}</td>
                  <td>{{ articles_sous_categorie.prix }}</td>
                  <td class="text-end">
                    <a href="{{ path('app_articles_sous_categorie_edit',{'url' :articles_sous_categorie.url }) }}" title="Modifier"><i class="fas fa-pencil-alt"></i></a>
                    <a href="{{ path('app_articles_sous_categorie_show',{'url' :articles_sous_categorie.id }) }}" title="Supprimer"><i class="fas fa-trash ms-2"></i></a>
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="4">Aucun enregistrement</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="categorie" tabindex="-1" aria-labelledby="categorieLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categorieLabel">Nouvelle sous-catégorie</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      {{ form_start(form) }}
      <div class="modal-body">
        <div class="mb-3">
          <label class="col-form-label">Nom article :</label>
          {{ form_widget(form.noms) }}
        </div>
        <div class="mb-3">
          <label class="col-form-label">Code article :</label>
          {{ form_widget(form.codeArticles) }}
        </div>
        <div class="mb-3">
          <label class="col-form-label">Prix :</label>
          {{ form_widget(form.prix) }}
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
