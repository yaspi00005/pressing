{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}
{% set fil = [{label: 'Administration', url: path('app_admin_users')}] %}

{% block body %}
<div class="card">
    <div class="card-header flex-wrap gap-2">
        <h4 class="card-title">{{ users|length }} utilisateur{{ users|length > 1 ? 's' }}</h4>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary btn-sm btn-rounded"><i class="fas fa-plus"></i> Nouvel utilisateur</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead><tr><th>Utilisateur</th><th>Identifiant</th><th>Téléphone</th><th>Rôle</th><th>État</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td class="fw-bold">{{ u.nomComplet }}</td>
                            <td>{{ u.username }}</td>
                            <td>{{ u.telephone ?: '—' }}</td>
                            <td><span class="badge bg-{{ 'ROLE_ADMIN' in u.roles ? 'primary' : 'secondary' }}">{{ u.roleLabel }}</span></td>
                            <td>{{ include('partials/_badge_actif.html.twig', {actif: u.actif}) }}</td>
                            <td class="text-end text-nowrap">
                                <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="btn btn-outline-secondary btn-xs sharp" title="Modifier"><i class="fas fa-pen"></i></a>
                                {% if u != app.user %}
                                    <form method="post" action="{{ path('app_admin_user_toggle', {id: u.id}) }}" class="d-inline"
                                          data-confirm="{{ u.actif ? 'Cette personne ne pourra plus se connecter.' : 'Cette personne pourra de nouveau se connecter.' }}"
                                          data-confirm-titre="{{ u.actif ? 'Désactiver ce compte ?' : 'Réactiver ce compte ?' }}"
                                          data-confirm-type="{{ u.actif ? 'danger' : 'primary' }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('user' ~ u.id) }}">
                                        <button class="btn btn-outline-{{ u.actif ? 'danger' : 'success' }} btn-xs sharp" title="{{ u.actif ? 'Désactiver' : 'Réactiver' }}"><i class="fas {{ u.actif ? 'fa-user-slash' : 'fa-user-check' }}"></i></button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
