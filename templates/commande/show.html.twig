{% extends 'base.html.twig' %}

{% block title %}Commande {{ commande.numero }}{% endblock %}
{% set fil = [{label: 'Commandes', url: path('app_commande_index')}] %}

{% block body %}
{# En-tête de fiche : identité à gauche, boutons à droite #}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 entete-fiche">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <h3>{{ commande.numero }}</h3>
        {{ include('partials/_badge.html.twig', {commande: commande}, with_context = false) }}
        {{ include('partials/_badge.html.twig', {paiement: commande}, with_context = false) }}
        {% if commande.urgent %}<span class="badge bg-danger">Express</span>{% endif %}
        {% if commande.enRetard %}<span class="badge bg-danger">En retard</span>{% endif %}
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a href="{{ path('app_commande_ticket', {id: commande.id}) }}#print" target="_blank" class="btn btn-outline-primary btn-sm"><i class="fas fa-print"></i> Ticket</a>
        {% if is_granted('ROLE_RECEPTION') and not commande.terminee %}<a href="{{ path('app_commande_edit', {id: commande.id}) }}" class="btn btn-primary btn-sm btn-rounded"><i class="fas fa-pen"></i> Modifier</a>{% endif %}
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <div class="row">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header"><h4 class="card-title"><i class="fas fa-user text-primary me-2"></i>Client</h4></div>
                    <div class="card-body">
                        <p class="mb-1"><a href="{{ path('app_clients_show', {id: commande.client.id}) }}" class="fw-bold">{{ commande.client.nomComplet }}</a></p>
                        <p class="mb-1"><i class="fas fa-phone text-muted me-1"></i> {{ commande.client.telephones }}</p>
                        <p class="mb-0"><i class="fas fa-map-marker-alt text-muted me-1"></i> {{ commande.client.adresses }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header"><h4 class="card-title"><i class="fas fa-calendar text-primary me-2"></i>Dates et retour</h4></div>
                    <div class="card-body">
                        <p class="mb-1">Déposée le <strong>{{ commande.dateDepot|date('d/m/Y H:i') }}</strong>{% if commande.createdBy %} <small class="text-muted">par {{ commande.createdBy.nomComplet }}</small>{% endif %}</p>
                        <p class="mb-1 {{ commande.enRetard ? 'text-danger' }}">Retrait prévu <strong>{{ commande.dateRetraitPrevue|date('d/m/Y H:i') }}</strong></p>
                        {% if commande.dateLivraison %}<p class="mb-1">Livrée le <strong>{{ commande.dateLivraison|date('d/m/Y H:i') }}</strong></p>{% endif %}
                        <p class="mb-0">{{ commande.livraisonDomicile ? 'Livraison à domicile : ' ~ commande.adresseLivraison : 'Retrait au pressing' }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-tshirt text-primary me-2"></i>Articles ({{ commande.nombrePieces }})</h4></div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Article</th><th>Service</th><th class="num">Qté</th><th class="num">P.U.</th><th class="num">Montant</th></tr></thead>
                        <tbody>
                            {% for l in commande.lignes %}
                                <tr>
                                    <td>{{ l.article.noms }}{% if l.observation %}<br><small>{{ l.observation }}</small>{% endif %}</td>
                                    <td>{{ l.service.nom }}</td>
                                    <td class="num">{{ l.quantite }}</td>
                                    <td class="num">{{ l.prixUnitaire|money }}</td>
                                    <td class="num">{{ l.montant|money }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr><td colspan="4" class="num">Sous-total</td><td class="num">{{ commande.sousTotal|money }}</td></tr>
                            {% if commande.majoration %}<tr><td colspan="4" class="num">Majoration express ({{ commande.majorationPourcent }} %)</td><td class="num">{{ commande.majoration|money }}</td></tr>{% endif %}
                            {% if commande.fraisLivraison %}<tr><td colspan="4" class="num">Livraison</td><td class="num">{{ commande.fraisLivraison|money }}</td></tr>{% endif %}
                            {% if commande.remise %}<tr><td colspan="4" class="num">Remise</td><td class="num text-success">-{{ commande.remise|money }}</td></tr>{% endif %}
                            <tr><th colspan="4" class="num">Total</th><th class="num">{{ commande.total|money }}</th></tr>
                        </tfoot>
                    </table>
                </div>
                {% if commande.notes %}<p class="text-muted mb-0"><i class="fas fa-sticky-note me-1"></i> {{ commande.notes }}</p>{% endif %}
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-coins text-primary me-2"></i>Paiements</h4></div>
            <div class="card-body pt-0">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead><tr><th>Date</th><th>Mode</th><th>Référence</th><th>Caissier</th><th class="num">Montant</th></tr></thead>
                        <tbody>
                            {% for p in commande.paiements %}
                                <tr><td>{{ p.datePaiement|date('d/m/Y H:i') }}</td><td>{{ p.modeLabel }}</td><td>{{ p.reference ?: '—' }}</td><td>{{ p.createdBy ? p.createdBy.nomComplet : '—' }}</td><td class="num">{{ p.montant|money }}</td></tr>
                            {% else %}
                                {{ include('partials/_empty_state.html.twig', {colonnes: 5, message: 'Aucun paiement.', icone: 'fa-coins'}, with_context = false) }}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {{ include('partials/_journal_fiche.html.twig', {entrees: journal}) }}
    </div>

    {# Colonne de droite : actions (les cartes dépendent du rôle) #}
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fab fa-whatsapp text-primary me-2"></i>Prévenir le client</h4></div>
            <div class="card-body">
                <a href="{{ whatsapp_link(commande) }}" target="_blank" rel="noopener" class="btn btn-success w-100"><i class="fab fa-whatsapp"></i> WhatsApp à {{ commande.client.prenom }}</a>
                <p class="small text-muted mt-2 mb-0">Le message s'adapte au statut (reçue, prête, livrée) et rappelle le reste à payer.</p>
            </div>
        </div>

        {% if not commande.terminee %}
            <div class="card carte-action">
                <div class="card-header"><h4 class="card-title"><i class="fas fa-route text-primary me-2"></i>Avancement</h4></div>
                <div class="card-body">
                    {% set suivant = commande.statutSuivant %}
                    {% set peut = suivant and (suivant != 'livre' or is_granted('ROLE_RECEPTION')) %}
                    {% if peut %}
                        <form method="post" action="{{ path('app_commande_statut', {id: commande.id}) }}" class="mb-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('statut' ~ commande.id) }}">
                            <input type="hidden" name="statut" value="{{ suivant }}">
                            {% if suivant == 'livre' and not commande.solde %}
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="forcer" value="1" id="forcer">
                                    <label class="form-check-label" for="forcer">Livrer à crédit (reste {{ commande.reste|money }})</label>
                                </div>
                            {% endif %}
                            <button class="btn btn-primary w-100">Passer à « {{ constant('App\\Entity\\Commande::STATUTS')[suivant] }} »</button>
                        </form>
                    {% elseif suivant %}
                        <p class="text-muted small mb-2">La remise du linge se fait au guichet (réception).</p>
                    {% endif %}
                    {% if is_granted('ROLE_RECEPTION') %}
                        <form method="post" action="{{ path('app_commande_statut', {id: commande.id}) }}" data-confirm="Cette commande sera marquée « Annulée »." data-confirm-titre="Annuler la commande ?" data-confirm-type="danger" data-confirm-bouton="Oui, annuler">
                            <input type="hidden" name="_token" value="{{ csrf_token('statut' ~ commande.id) }}">
                            <input type="hidden" name="statut" value="annule">
                            <button class="btn btn-outline-danger w-100">Annuler la commande</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <div class="card">
            <div class="card-header"><h4 class="card-title"><i class="fas fa-wallet text-primary me-2"></i>Montants</h4></div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><td>Total</td><td class="num">{{ commande.total|money }}</td></tr>
                    <tr><td>Déjà payé</td><td class="num text-success">{{ commande.totalPaye|money }}</td></tr>
                    <tr class="border-top"><th>Reste à payer</th><th class="num {{ commande.reste ? 'text-danger' : 'text-success' }}">{{ commande.reste|money }}</th></tr>
                </table>
            </div>
        </div>

        {% if is_granted('ROLE_RECEPTION') and commande.reste > 0 and commande.statut != 'annule' %}
            <div class="card carte-action">
                <div class="card-header"><h4 class="card-title"><i class="fas fa-cash-register text-primary me-2"></i>Encaisser</h4></div>
                <div class="card-body">
                    <form method="post" action="{{ path('app_commande_paiement', {id: commande.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('paiement' ~ commande.id) }}">
                        <div class="mb-2"><label class="form-label">Montant</label><input type="number" name="montant" min="1" max="{{ commande.reste }}" value="{{ commande.reste }}" class="form-control" required inputmode="numeric"></div>
                        <div class="mb-2"><label class="form-label">Mode</label><select name="mode" class="form-select">{% for k, label in modes %}<option value="{{ k }}">{{ label }}</option>{% endfor %}</select></div>
                        <div class="mb-3"><label class="form-label">Référence</label><input type="text" name="reference" class="form-control" placeholder="N° transaction, chèque…"></div>
                        <button class="btn btn-success w-100">Encaisser</button>
                    </form>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
