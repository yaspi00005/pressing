{# Tableau des commandes. Paramètres : commandes, compact (facultatif : masque les colonnes secondaires) #}
<table class="table table-hover">
    <thead>
        <tr>
            <th>N° ticket</th>
            <th>Client</th>
            <th>Retrait prévu</th>
            {% if not compact|default(false) %}<th class="num">Pièces</th>{% endif %}
            <th class="num">Total</th>
            <th class="num">Reste</th>
            <th>Statut</th>
            {% if not compact|default(false) %}<th>Paiement</th>{% endif %}
        </tr>
    </thead>
    <tbody>
        {% for c in commandes %}
            <tr>
                <td>
                    <a href="{{ path('app_commande_show', {id: c.id}) }}" class="text-primary fw-bold">{{ c.numero }}</a>
                    {% if c.urgent %}<span class="badge bg-danger">Express</span>{% endif %}
                    <br><small>{{ c.dateDepot|date('d/m/Y H:i') }}</small>
                </td>
                <td>{{ c.client.nomComplet }}<br><small>{{ c.client.telephones }}</small></td>
                <td class="{{ c.enRetard ? 'text-danger fw-bold' }}">{{ c.dateRetraitPrevue|date('d/m/Y H:i') }}{% if c.enRetard %} <i class="fas fa-clock" title="En retard"></i>{% endif %}</td>
                {% if not compact|default(false) %}<td class="num">{{ c.nombrePieces }}</td>{% endif %}
                <td class="num">{{ c.total|money }}</td>
                <td class="num {{ c.reste > 0 and c.statut != 'annule' ? 'text-danger fw-bold' }}">{{ c.statut == 'annule' ? '—' : c.reste|money }}</td>
                <td>{{ include('partials/_badge.html.twig', {commande: c}, with_context = false) }}</td>
                {% if not compact|default(false) %}<td>{{ include('partials/_badge.html.twig', {paiement: c}, with_context = false) }}</td>{% endif %}
            </tr>
        {% else %}
            {{ include('partials/_empty_state.html.twig', {colonnes: compact|default(false) ? 6 : 8, message: 'Aucune commande ne correspond.', icone: 'fa-receipt'}, with_context = false) }}
        {% endfor %}
    </tbody>
</table>
