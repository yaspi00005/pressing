<table class="table table-hover mb-0">
  <thead>
    <tr>
      <th>N°</th>
      <th>Client</th>
      <th>Retrait prévu</th>
      <th>Pièces</th>
      <th class="text-end">Total</th>
      <th class="text-end">Reste</th>
      <th>Statut</th>
    </tr>
  </thead>
  <tbody>
    {% for c in commandes %}
      <tr>
        <td><a href="{{ path('app_commande_show', {id: c.id}) }}"><strong>{{ c.numero }}</strong></a>{% if c.urgent %} <span class="badge bg-danger">Express</span>{% endif %}</td>
        <td>{{ c.client.nomComplet }}</td>
        <td class="{{ c.enRetard ? 'text-danger fw-bold' : '' }}">{{ c.dateRetraitPrevue|date('d/m/Y H:i') }}{% if c.enRetard %} <i class="fas fa-clock" title="En retard"></i>{% endif %}</td>
        <td>{{ c.nombrePieces }}</td>
        <td class="text-end">{{ c.total|money }}</td>
        <td class="text-end {{ c.reste > 0 and c.statut != 'annule' ? 'text-warning fw-bold' : '' }}">{{ c.statut == 'annule' ? '—' : c.reste|money }}</td>
        <td><span class="badge bg-{{ c.statutBadge }}">{{ c.statutLabel }}</span></td>
      </tr>
    {% else %}
      <tr><td colspan="7" class="text-muted text-center">Aucune commande.</td></tr>
    {% endfor %}
  </tbody>
</table>
