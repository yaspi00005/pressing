{% extends 'base.html.twig' %}

{% import _self as m %}

{# Une ligne d'article (aussi utilisée comme modèle pour « + Ajouter un article ») #}
{% macro ligne(l) %}
  <div class="ligne-commande border rounded p-2 mb-2">
    <div class="row g-2 align-items-end">
      <div class="col-lg-4">{{ form_label(l.article) }}{{ form_widget(l.article) }}{{ form_errors(l.article) }}</div>
      <div class="col-lg-3 col-6">{{ form_label(l.service) }}{{ form_widget(l.service) }}{{ form_errors(l.service) }}</div>
      <div class="col-lg-1 col-3">{{ form_label(l.quantite) }}{{ form_widget(l.quantite) }}{{ form_errors(l.quantite) }}</div>
      <div class="col-lg-2 col-3">{{ form_label(l.prixUnitaire) }}{{ form_widget(l.prixUnitaire) }}{{ form_errors(l.prixUnitaire) }}</div>
      <div class="col-lg-2 d-flex align-items-center justify-content-between">
        <strong class="ligne-montant text-nowrap">0</strong>
        <button type="button" class="btn btn-outline-danger btn-sm ligne-supprimer" title="Retirer la ligne" aria-label="Retirer la ligne"><i class="fas fa-trash"></i></button>
      </div>
      <div class="col-12">{{ form_widget(l.observation, {attr: {placeholder: 'Observation : tache, couleur, défaut…'}}) }}</div>
    </div>
  </div>
{% endmacro %}

{% block title %}{{ titre }}{% endblock %}
{% set fil = [{label: 'Commandes', url: path('app_commande_index')}] %}

{% block body %}
{{ form_start(form, {attr: {id: 'commande-form', novalidate: 'novalidate', 'data-tarifs': tarifs|json_encode, 'data-base': prixBase|json_encode, 'data-majoration': majoration, 'data-devise': app_devise}}) }}
<div class="row">
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header"><h4 class="card-title"><i class="fas fa-user text-primary me-2"></i>Client</h4></div>
      <div class="card-body">
        {{ form_errors(form) }}
        <div class="row">
          <div class="col-md-8 mb-3">
            {{ form_label(form.client) }}
            {{ form_widget(form.client, {attr: {class: 'form-select js-select2', 'data-placeholder': 'Rechercher un client…'}}) }}
            {{ form_errors(form.client) }}
            <a href="{{ path('app_clients_new') }}" class="small" target="_blank" rel="noopener"><i class="fas fa-user-plus"></i> Nouveau client</a>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h4 class="card-title"><i class="fas fa-tshirt text-primary me-2"></i>Articles déposés</h4>
        <button type="button" id="ajouter-ligne" class="btn btn-primary btn-sm btn-rounded"><i class="fas fa-plus"></i> Ajouter un article</button>
      </div>
      <div class="card-body">
        {{ form_errors(form.lignes) }}
        <div id="lignes" data-prototype="{{ m.ligne(form.lignes.vars.prototype)|e('html_attr') }}" data-index="{{ form.lignes|length }}">
          {% for l in form.lignes %}{{ m.ligne(l) }}{% endfor %}
        </div>
        <p class="text-muted small mb-0">Le prix se remplit automatiquement depuis la grille tarifaire (article × service) ; il reste modifiable.</p>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h4 class="card-title"><i class="fas fa-truck text-primary me-2"></i>Délai et retour du linge</h4></div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">{{ form_row(form.dateRetraitPrevue) }}</div>
          <div class="col-md-6">
            <div class="form-check mt-md-4 mb-3">
              {{ form_widget(form.urgent) }}
              {{ form_label(form.urgent) }} <span class="text-muted">(+{{ majoration }} %)</span>
            </div>
          </div>
          <div class="col-md-6">{{ form_row(form.modeLivraison) }}</div>
          <div class="col-md-6 bloc-domicile">{{ form_row(form.fraisLivraison) }}</div>
          <div class="col-12 bloc-domicile">{{ form_row(form.adresseLivraison) }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-4">
    <div class="card carte-action">
      <div class="card-header"><h4 class="card-title"><i class="fas fa-wallet text-primary me-2"></i>Récapitulatif</h4></div>
      <div class="card-body">
        <table class="table table-borderless mb-2">
          <tr><td>Sous-total</td><td class="num" id="r-sous-total">0</td></tr>
          <tr id="r-ligne-majoration" class="d-none"><td>Majoration express</td><td class="num" id="r-majoration">0</td></tr>
          <tr id="r-ligne-livraison" class="d-none"><td>Livraison</td><td class="num" id="r-livraison">0</td></tr>
          <tr><td>Remise</td><td class="num text-success" id="r-remise">0</td></tr>
          <tr class="border-top"><th>Total</th><th class="num fs-5" id="r-total">0</th></tr>
        </table>
        {{ form_row(form.remise) }}
        {% if form.acompte is defined %}
          {{ form_row(form.acompte) }}
          {{ form_row(form.modeAcompte) }}
          <p class="mb-3">Reste à payer : <strong id="r-reste">0</strong></p>
        {% endif %}
        {{ form_row(form.notes) }}
        {{ form_rest(form) }}
        <div class="d-flex justify-content-end gap-2">
          <a href="{{ commande.id ? path('app_commande_show', {id: commande.id}) : path('app_commande_index') }}" class="btn btn-light">Annuler</a>
          <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
      </div>
    </div>
  </div>
</div>
{{ form_end(form, {render_rest: false}) }}
{% endblock %}
